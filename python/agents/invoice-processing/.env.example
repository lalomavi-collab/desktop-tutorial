# העתק לקובץ .env. קונפיג לא רגיש בלבד - אין כאן סיסמאות.
# ברירת המחדל היא עבודה דרך פרופיל Outlook Desktop ב-COM, בלי שום סיסמה.

MAIL_MODE=outlook_com
SEND_MODE=outlook_com

OUTLOOK_STORES=you@example.com

# מסלול חלופי לאותה תיבה בלבד (MAIL_MODE=imap / SEND_MODE=smtp).
# סיסמאות נשמרות ב-Windows Credential Manager דרך setup_credentials.bat
# ולא נכתבות לשום קובץ טקסט.
IMAP1_HOST=outlook.office365.com
IMAP1_PORT=993
IMAP1_USER=you@example.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@example.com

ACCOUNTING_EMAIL=office@ronitkolani.co.il

INVOICE_BASE_FOLDER=C:\Users\you\OneDrive\שולחן העבודה\LALUM\חשבוניות