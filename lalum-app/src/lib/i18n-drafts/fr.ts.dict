    audiences: [
      { icon: "spark", title: "Dirigeants et cadres", body: "La couche de jugement. Une maîtrise suffisante pour porter des initiatives IA, lire le risque, et poser les bonnes questions avant de valider.", points: ["Où l'IA crée une exposition juridique et en propriété intellectuelle", "Les obligations de l'AI Act européen au niveau du conseil d'administration", "Les décisions de gouvernance que vous assumez réellement"] },
      { icon: "brain", title: "Équipes développement et produit", body: "La couche de construction. Des pratiques concrètes pour que ce qui est livré soit conforme, propre en propriété intellectuelle, et défendable dès le premier commit.", points: ["La protection dès la conception (Privacy-by-Design) dans le pipeline", "Éviter la contamination du code source et des données", "Modèles locaux et RAG mis en œuvre en toute sécurité"] },
