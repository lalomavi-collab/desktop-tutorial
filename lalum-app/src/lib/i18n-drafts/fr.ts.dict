    plans: [
      { name: "Mandat à périmètre fixe", tagline: "Un engagement défini, un coût prévisible", best: "Idéal pour : un dossier unique à forts enjeux avec un livrable clair", popular: false, features: ["Délai de réponse inférieur à une heure", "Évaluation de risque algorithmique", "Livrable prêt pour le tribunal", "Prix fixe, sans facturation horaire"], cta: "Demander une proposition de périmètre" },
      { name: "Partenariat en abonnement", tagline: "Votre équipe juridique et IA intégrée", best: "Idéal pour : les organisations en croissance avec une exposition continue", popular: true, features: ["Réponse prioritaire sous une heure", "Un avocat dédié", "Surveillance continue du risque (RECIR)", "Conseil illimité"], cta: "Réserver une consultation" },
