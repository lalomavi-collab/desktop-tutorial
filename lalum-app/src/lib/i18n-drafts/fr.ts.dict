  data: {
    pillars: [
      { icon: "scale", tag: "AI Act européen", title: "Régulation de l'IA et conformité à l'AI Act européen", body: "Classification des risques, obligations GPAI, et documentation technique, intégrées dans une matrice de conformité ordonnée. Pour les exportateurs de technologie et pour les audits d'acquisition en M&A et capital risque, avant l'échéance des systèmes à haut risque d'août 2026." },
      { icon: "brain", tag: "Gouvernance du risque", title: "Responsabilité IA et gouvernance du risque", body: "Pour les conseils d'administration, les dirigeants et les experts comptables : un indice de conformité et une matrice d'exposition qui chiffrent votre responsabilité algorithmique tôt, avant qu'un régulateur ou un plaignant ne le fasse." },
      { icon: "shield", tag: "PI et données", title: "Propriété intellectuelle et protection des données", body: "Une couche de propriété intellectuelle défendable autour de votre technologie et une architecture de données sécurisée et conçue selon les principes de protection dès la conception (Privacy-by-Design) : brevets, secrets d'affaires et modèles propriétaires." },
      { icon: "settings", tag: "Contrats et capital risque", title: "Contrats et conseil en capital risque", body: "Gouvernance contractuelle automatisée, conseil pour les startups et entreprises technologiques, tours de financement et pactes d'associés, et audits d'acquisition technologique pour les transactions." },
      { icon: "search", tag: "Secteur public", title: "IA dans le secteur public", body: "Pour les municipalités, les ministères et les marchés publics : des systèmes de décision explicables et audités contre les biais, résistants aux recours administratifs et au contrôle de la Cour des comptes." },
      { icon: "gavel", tag: "Médiation DOM", title: "Médiation et résolution des litiges (DOM)", body: "Médiation orientée décision pour les litiges en matière d'IA, d'entreprise et de régulation, et défense des décisions automatisées contestées, sur un dossier défendable." },
    ] as Pillar[],
    frameworks: [
      { code: "CLASSIFY", title: "Classification des risques", icon: "search", body: "Nous classons chaque système selon les niveaux de risque de l'AI Act européen et les seuils GPAI, afin que vous sachiez exactement quelles obligations vous engagent, et à quelle échéance." },
      { code: "CERTIFY", title: "Conformité signée", icon: "shield", body: "Une matrice de conformité signée et un avis réglementaire, sourcés et datés, qui résistent à un audit, à un conseil d'administration et à une salle d'audit d'acquisition." },
      { code: "DEFEND", title: "Défense judiciaire algorithmique", icon: "gavel", body: "Lorsqu'une décision est contestée, nous défendons l'algorithme : le dossier documenté qui résiste au contre-interrogatoire et au contrôle administratif." },
    ] as Framework[],
    why: [
      { icon: "spark", title: "Cabinet et laboratoire", body: "Un conseil juridique de premier plan et une pratique de solutions IA sous un même toit, sans transmission, sans perte en traduction." },
      { icon: "scale", title: "Précision algorithmique", body: "La logique juridique gouverne les statistiques, jamais l'inverse. Le moteur augmente le jugement ; il ne le remplace jamais." },
      { icon: "gavel", title: "Défendable par conception", body: "Chaque décision sourcée, datée et reproductible, conçue pour résister devant un juge." },
      { icon: "book", title: "20+ ans, forts enjeux", body: "Une expérience approfondie là où l'exposition est réelle : technologie, entreprises réglementées et institutions publiques." },
    ] as Why[],
    faqs: [
      { q: "Qu'est-ce qui distingue votre cabinet des cabinets de droit des technologies traditionnels ?", a: "Les cabinets traditionnels conseillent en droit sans comprendre la moindre ligne de code. Nous comblons cet écart. En tant que cabinet boutique Tech-Legal, nous opérons à l'intersection du droit avancé, de l'économie appliquée et de l'architecture IA. Nous comprenons votre produit, vos systèmes RAG et vos structures de bases de données dès le premier jour, afin que votre cadre juridique soit conçu pour protéger et renforcer vos actifs technologiques." },
      { q: "Comment aidez-vous les startups à protéger leur propriété intellectuelle lors de l'usage de l'IA générative ?", a: "Nous mettons en œuvre des protocoles stricts de protection dès la conception (Privacy-by-Design). Cela inclut la mise en place d'environnements locaux sécurisés (utilisant des modèles open source) pour empêcher la propriété intellectuelle sensible et les données clients de fuiter vers des clouds publics. Nous concevons également des politiques d'utilisation de l'IA solides pour garantir que vos développeurs ne contaminent pas votre code source propriétaire avec du contenu protégé par des droits de tiers, ce qui pourrait autrement compromettre un futur financement ou une opération de M&A." },
      { q: "Qu'est-ce que le modèle Clinic and Engine ?", a: "C'est notre cadre opérationnel à double moteur. La Clinic représente notre savoir, notre recherche et notre conseil de premier plan, où nous animons des masterclasses, des formations exécutives et rédigeons des stratégies juridiques sur mesure. L'Engine est notre bras d'exécution et d'intégration, où nous construisons des plateformes IA sécurisées, automatisons la gouvernance contractuelle et concevons l'infrastructure tech-legal concrète de votre entreprise." },
      { q: "Comment aidez-vous les organismes publics et les collectivités locales à adopter l'IA en toute sécurité ?", a: "Nous construisons la couche de gouvernance qu'exige l'adoption publique : des systèmes de décision explicables, un audit documenté des biais, et un dossier défendable pour chaque décision automatisée. Le résultat résiste aux recours administratifs, à l'examen au titre de la liberté d'information et au contrôle de la Cour des comptes, de sorte qu'une autorité puisse adopter l'IA sans s'exposer à la contestation qui suit les systèmes opaques et non redevables." },
      { q: "Qu'est-ce que la DOM (médiation orientée décision) et comment fonctionne-t-elle ?", a: "La DOM est notre cadre propriétaire de résolution des litiges en 8 modules, conçu pour les conflits complexes en matière d'IA, d'entreprise et de régulation. Contrairement au contentieux traditionnel et prolongé ou à la médiation standard, la DOM est strictement limitée dans le temps, analytique et hautement structurée. Elle combine le droit et la modélisation économique pour conduire les parties vers un règlement optimal et juridiquement contraignant, sans épuiser les ressources de l'organisation." },
      { q: "Pouvez-vous aider notre entreprise à se conformer aux régulations mondiales de l'IA comme l'AI Act européen ?", a: "Oui. Nous sommes spécialisés dans l'ingénierie réglementaire proactive. Nous réalisons des évaluations de risque algorithmique et alignons votre pile technologique sur les cadres mondiaux les plus stricts (y compris l'AI Act européen et les lois avancées sur la confidentialité). Nous transformons la conformité, d'un obstacle bureaucratique, en un avantage concurrentiel qui renforce la confiance des clients entreprise." },
      { q: "Construisez-vous vous-mêmes les plateformes IA et les flux de travail automatisés pour vos clients ?", a: "Absolument. Nous ne nous contentons pas de rédiger des contrats ; nous concevons les systèmes qui les gouvernent. Nous aidons les organisations à construire des plateformes IA internes sécurisées, des bases de données vectorielles sur mesure, et des flux de travail contractuels automatisés (workflows agentiques) qui gèrent et atténuent les risques en temps réel, sans friction." },
      { q: "Que couvre votre accompagnement juridique complet pour les startups ?", a: "Nous fournissons un accompagnement juridique et économique de bout en bout, de la création jusqu'à la croissance. Cela comprend la structuration de pactes d'associés sophistiqués, la cession de propriété intellectuelle, la gouvernance d'entreprise, la construction de projets entrepreneuriaux, et la représentation de la société lors de tours de financement (SAFE, capital) et d'opérations de M&A stratégiques." },
      { q: "Pourquoi une perspective économique (droit et économie) est-elle essentielle pour mon entreprise technologique ?", a: "La régulation technologique est fondamentalement de nature économique. En appliquant rigoureusement les principes du droit et de l'économie, nous ne nous limitons pas à ce qui est légalement permis ; nous modélisons l'impact financier et opérationnel des structures juridiques sur votre entreprise. L'objectif est une architecture juridique qui soutient une croissance durable et protège la valeur de l'entreprise." },
      { q: "Comment fonctionnent vos formations d'entreprise et vos masterclasses ?", a: "Nous animons des masterclasses et des ateliers hautement spécialisés et concrets pour les conseils d'administration, les équipes dirigeantes et les départements R&D. Nous traduisons les concepts tech-legal complexes, les risques algorithmiques et l'évolution des régulations en outils pratiques d'aide à la décision pour l'entreprise." },
      { q: "Comment commencer à travailler avec vous ?", a: "Nous commençons par une session stratégique de diagnostic Tech-Legal. Lors de cette première réunion, nous cartographions votre architecture technique actuelle, votre structure d'entreprise et votre exposition réglementaire, afin d'identifier les vulnérabilités immédiates et de concevoir une feuille de route sur mesure pour votre projet." },
    ] as Faq[],
    advisoryServices: [
      { icon: "scale", title: "Régulation de l'IA et conformité à l'AI Act européen", body: "Cartographie et gestion de l'exposition réglementaire avancée, y compris l'AI Act européen, dès le stade du développement. Classification des risques, obligations GPAI, et documentation technique, intégrées dans une matrice de conformité ordonnée avant l'échéance des systèmes à haut risque d'août 2026." },
      { icon: "brain", title: "Responsabilité IA et gouvernance du risque", body: "Pour les conseils d'administration, les dirigeants et les experts comptables : un indice de conformité et une matrice d'exposition exécutive qui chiffrent votre responsabilité algorithmique tôt, avant qu'un régulateur ou un plaignant ne le fasse." },
      { icon: "shield", title: "Propriété intellectuelle et protection des données", body: "Une couche de propriété intellectuelle défendable autour de votre technologie, de vos brevets, secrets d'affaires et modèles propriétaires, associée à une architecture locale et RAG sécurisée conçue selon les principes de protection dès la conception (Privacy-by-Design), afin que la protection soit intégrée dès la fondation plutôt qu'ajoutée après coup." },
      { icon: "settings", title: "Contrats et conseil en capital risque", body: "Gouvernance contractuelle automatisée sur tout le cycle de vie, ainsi qu'une enveloppe stratégique pour les entreprises technologiques : constitution, tours de financement, pactes d'associés et accords avec les salariés, et audits d'acquisition technologique pour les transactions et les levées de fonds." },
      { icon: "search", title: "IA dans le secteur public", body: "Conseil continu en IA pour les autorités, institutions et sociétés publiques : gouvernance, préparation réglementaire, marchés publics, et systèmes de décision explicables et audités contre les biais, résistants aux recours administratifs et au contrôle de la Cour des comptes." },
      { icon: "gavel", title: "Médiation et résolution des litiges (DOM)", body: "Médiation orientée décision pour les litiges en matière d'IA, d'entreprise et de régulation, et défense signée des décisions automatisées contestées : le dossier sourcé et daté qui résiste aux recours, aux allégations de biais et au contrôle réglementaire." },
    ] as Service[],
    domModules: [
