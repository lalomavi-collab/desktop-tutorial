    plans: [
      { name: "Mandato de alcance fijo", tagline: "Un encargo definido, un costo predecible", best: "Ideal para: un único asunto de alto riesgo con un entregable claro", popular: false, features: ["Tiempo de respuesta menor a una hora", "Evaluación de riesgo algorítmico", "Entregable listo para el tribunal", "Precio fijo, sin facturación por hora"], cta: "Solicitar una propuesta de alcance" },
      { name: "Alianza de retención (retainer)", tagline: "Su equipo legal y de IA integrado", best: "Ideal para: organizaciones en crecimiento con exposición continua", popular: true, features: ["Respuesta prioritaria en menos de una hora", "Un abogado dedicado", "Monitoreo continuo de riesgo (RECIR)", "Asesoría ilimitada"], cta: "Reservar una consulta" },
    ] as Plan[],
    audiences: [
      { icon: "spark", title: "Liderazgo y ejecutivos", body: "La capa de criterio. Suficiente fluidez para respaldar iniciativas de IA, leer el riesgo, y hacer las preguntas correctas antes de dar la aprobación.", points: ["Dónde la IA genera exposición legal y de propiedad intelectual", "Obligaciones del Reglamento de IA de la UE a nivel de consejo directivo", "Decisiones de gobernanza que realmente les corresponden"] },
      { icon: "brain", title: "Equipos de desarrollo y producto", body: "La capa de construcción. Prácticas concretas para que lo que se lanza sea conforme, libre de riesgos de propiedad intelectual, y defendible desde el primer commit.", points: ["Privacy-by-Design en el pipeline", "Cómo evitar la contaminación de código fuente y datos", "Modelos locales y RAG hechos de forma segura"] },
