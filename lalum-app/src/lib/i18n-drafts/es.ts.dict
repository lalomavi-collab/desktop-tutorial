  data: {
    pillars: [
      { icon: "scale", tag: "Reglamento de IA de la UE", title: "Regulación de IA y Conformidad con el Reglamento de IA de la UE", body: "Clasificación de riesgo, obligaciones de IA de propósito general (GPAI), y documentación técnica, mapeadas en una matriz de conformidad ordenada. Para exportadores tecnológicos y para diligencia debida en fusiones y adquisiciones y capital de riesgo, antes del plazo de agosto de 2026 para sistemas de alto riesgo." },
      { icon: "brain", tag: "Gobernanza de Riesgo", title: "Responsabilidad de IA y Gobernanza de Riesgo", body: "Para consejos directivos, ejecutivos, y contadores públicos: un índice de conformidad y una matriz de exposición que calculan su responsabilidad algorítmica de forma temprana, antes de que lo haga un regulador o un demandante." },
      { icon: "shield", tag: "Propiedad Intelectual y Datos", title: "Propiedad Intelectual y Protección de Datos", body: "Una capa defendible de propiedad intelectual alrededor de su tecnología y una arquitectura de datos segura y Privacy-by-Design: patentes, secretos comerciales, y modelos propios." },
      { icon: "settings", tag: "Contratos y Venture", title: "Contratos y Asesoría para Venture", body: "Gobernanza automatizada de contratos, asesoría para startups y empresas tecnológicas, rondas de financiación y acuerdos de fundadores, y diligencia debida tecnológica para operaciones." },
      { icon: "search", tag: "Sector Público", title: "IA en el Sector Público", body: "Para municipios, ministerios, y licitaciones públicas: sistemas de decisión explicables y auditados contra sesgos, capaces de resistir recursos administrativos y la revisión del Contralor del Estado." },
      { icon: "gavel", tag: "Mediación DOM", title: "Mediación y Resolución de Disputas (DOM)", body: "Mediación Orientada a la Decisión para disputas de IA, corporativas, y regulatorias, y defensa de decisiones automatizadas impugnadas, con un registro defendible." },
    ] as Pillar[],
    frameworks: [
      { code: "CLASSIFY", title: "Clasificación de riesgo", icon: "search", body: "Clasificamos cada sistema conforme a los niveles de riesgo del Reglamento de IA de la UE y los umbrales de GPAI, para que sepa exactamente qué obligaciones lo vinculan, y para cuándo." },
      { code: "CERTIFY", title: "Conformidad firmada", icon: "shield", body: "Una matriz de conformidad firmada y un dictamen regulatorio, con fuentes y fechas, que se sostiene ante una auditoría, una sala de consejo, y una sala de diligencia debida." },
      { code: "DEFEND", title: "Defensa judicial algorítmica", icon: "gavel", body: "Cuando se impugna una decisión, defendemos el algoritmo: el registro documentado que sobrevive al contrainterrogatorio y a la revisión administrativa." },
    ] as Framework[],
    why: [
      { icon: "spark", title: "Despacho y laboratorio", body: "Asesoría legal de primer nivel y una práctica de soluciones de IA bajo un mismo techo, sin transferencias, sin pérdida en la traducción." },
      { icon: "scale", title: "Precisión algorítmica", body: "La lógica jurídica rige la estadística, nunca al revés. El motor amplifica el criterio; nunca lo sustituye." },
      { icon: "gavel", title: "Defendible por diseño", body: "Cada decisión con fuente, fecha, y reproducible, construida para sostenerse ante un juez." },
      { icon: "book", title: "Más de 20 años, alto riesgo", body: "Amplia experiencia donde la exposición es real: tecnología, empresas reguladas, e instituciones públicas." },
    ] as Why[],
    faqs: [
      { q: "¿Qué diferencia a su despacho de los despachos tecnológicos tradicionales?", a: "Los despachos tradicionales asesoran sobre derecho sin entender una sola línea de código. Nosotros cerramos esa brecha. Como boutique Tecnológico-Legal, operamos en la intersección entre el derecho avanzado, la economía aplicada, y la arquitectura de IA. Entendemos su producto, sus sistemas RAG, y sus estructuras de bases de datos desde el primer día, de modo que su marco legal está diseñado para proteger y fortalecer sus activos tecnológicos." },
      { q: "¿Cómo ayudan a las startups a proteger su propiedad intelectual al usar IA generativa?", a: "Implementamos protocolos estrictos de Privacy-by-Design. Esto incluye establecer entornos locales seguros (usando modelos de código abierto) para evitar que la propiedad intelectual sensible y los datos de clientes se filtren a nubes públicas. También diseñamos políticas robustas de uso de IA para asegurar que sus desarrolladores no contaminen su código fuente propio con material de terceros protegido por derechos de autor, lo que de otro modo podría poner en riesgo futuras rondas de financiación o fusiones y adquisiciones." },
      { q: "¿Qué es el modelo de Clínica y Motor?", a: "Es nuestro marco operativo de doble fuerza. La Clínica representa nuestro conocimiento, investigación, y asesoría de primer nivel, donde impartimos clases magistrales, formación ejecutiva, y redactamos estrategias legales a medida. El Motor es nuestro brazo de ejecución e integración, donde construimos plataformas de IA seguras, automatizamos la gobernanza de contratos, y diseñamos la infraestructura tecnológico-legal real para su negocio." },
      { q: "¿Cómo ayudan a los organismos del sector público y a las autoridades locales a adoptar la IA de forma segura?", a: "Construimos la capa de gobernanza que exige la adopción pública: sistemas de decisión explicables, auditoría documentada de sesgos, y un registro defendible para cada determinación automatizada. El resultado resiste recursos administrativos, el escrutinio de libertad de información, y la revisión del Contralor del Estado, de modo que una autoridad pueda adoptar IA sin invitar al desafío que sigue a los sistemas opacos y sin rendición de cuentas." },
      { q: "¿Qué es el DOM (Mediación Orientada a la Decisión) y cómo funciona?", a: "DOM es nuestro marco propio de resolución de disputas de 8 módulos, diseñado para conflictos complejos de IA, corporativos, y regulatorios. A diferencia del litigio tradicional y prolongado o de la mediación estándar, el DOM está estrictamente limitado en el tiempo, es analítico, y está altamente estructurado. Combina derecho y modelado económico para conducir a las partes hacia un acuerdo óptimo y legalmente vinculante sin agotar los recursos de la organización." },
      { q: "¿Pueden ayudar a nuestra empresa a cumplir con regulaciones globales de IA como el Reglamento de IA de la UE?", a: "Sí. Nos especializamos en ingeniería regulatoria proactiva. Realizamos evaluaciones de riesgo algorítmico y alineamos su pila tecnológica con los marcos globales más estrictos (incluido el Reglamento de IA de la UE y leyes de privacidad avanzadas). Convertimos el cumplimiento normativo de un obstáculo burocrático en una ventaja competitiva que genera confianza con los clientes empresariales." },
      { q: "¿Construyen las plataformas de IA reales y los flujos de trabajo automatizados para los clientes?", a: "Por supuesto. No solo redactamos contratos; diseñamos los sistemas que los gobiernan. Ayudamos a las organizaciones a construir plataformas internas de IA seguras, bases de datos vectoriales personalizadas, y flujos de trabajo de contratos automatizados (Agentic Workflows) que gestionan y mitigan riesgos en tiempo real y sin fricción." },
      { q: "¿Qué cubre su asesoría legal integral para startups?", a: "Ofrecemos respaldo legal y económico de principio a fin desde la constitución hasta el crecimiento. Esto incluye estructurar acuerdos de fundadores sofisticados, cesión de propiedad intelectual, gobierno corporativo, construcción de venture, y representar a la empresa en rondas de capital (SAFE, Equity) y transacciones estratégicas de fusiones y adquisiciones." },
      { q: "¿Por qué es crucial una perspectiva económica (Derecho y Economía) para mi empresa tecnológica?", a: "La regulación tecnológica es fundamentalmente económica. Al aplicar principios rigurosos de Derecho y Economía, no solo observamos lo que es legalmente permisible; modelamos el impacto financiero y operativo de las estructuras legales en su negocio. El objetivo es una arquitectura legal que sostenga un crecimiento sostenible y proteja el valor de la empresa." },
      { q: "¿Cómo funcionan sus capacitaciones corporativas y clases magistrales?", a: "Impartimos clases magistrales y talleres altamente especializados y prácticos para consejos directivos, equipos ejecutivos, y departamentos de I+D. Traducimos conceptos tecnológico-legales complejos, riesgos algorítmicos, y regulaciones cambiantes en herramientas prácticas de toma de decisiones orientadas al negocio." },
      { q: "¿Cómo empezamos a trabajar con ustedes?", a: "Comenzamos con una sesión estratégica de Diagnóstico Tecnológico-Legal. En esta reunión inicial, mapeamos su arquitectura técnica actual, su estructura corporativa, y su exposición regulatoria para identificar vulnerabilidades inmediatas y diseñar una hoja de ruta a medida para su empresa." },
    ] as Faq[],
    advisoryServices: [
      { icon: "scale", title: "Regulación de IA y Conformidad con el Reglamento de IA de la UE", body: "Mapeo y gestión de la exposición regulatoria avanzada, incluido el Reglamento de IA de la UE, desde la etapa de desarrollo. Clasificación de riesgo, obligaciones de GPAI, y documentación técnica, mapeadas en una matriz de conformidad ordenada antes del plazo de agosto de 2026 para sistemas de alto riesgo." },
      { icon: "brain", title: "Responsabilidad de IA y Gobernanza de Riesgo", body: "Para consejos directivos, ejecutivos, y contadores públicos: un índice de conformidad y una matriz ejecutiva de exposición que calculan su responsabilidad algorítmica de forma temprana, antes de que lo haga un regulador o un demandante." },
      { icon: "shield", title: "Propiedad Intelectual y Protección de Datos", body: "Una capa defendible de propiedad intelectual alrededor de su tecnología, patentes, secretos comerciales, y modelos propios, junto con una arquitectura local de modelos y RAG segura y construida bajo Privacy-by-Design, de modo que la protección esté en los cimientos y no añadida después." },
      { icon: "settings", title: "Contratos y Asesoría para Venture", body: "Gobernanza automatizada de contratos a lo largo de todo su ciclo de vida, además de un acompañamiento estratégico para empresas tecnológicas: constitución, rondas de financiación, acuerdos de fundadores y empleados, y diligencia debida tecnológica para operaciones y rondas de inversión." },
      { icon: "search", title: "IA en el Sector Público", body: "Asesoría continua de IA para autoridades, instituciones, y empresas públicas: gobernanza, preparación regulatoria, contratación pública, y sistemas de decisión explicables y auditados contra sesgos, capaces de resistir recursos administrativos y la revisión del Contralor del Estado." },
      { icon: "gavel", title: "Mediación y Resolución de Disputas (DOM)", body: "Mediación Orientada a la Decisión para disputas de IA, corporativas, y regulatorias, y defensa firmada de decisiones automatizadas impugnadas: el registro con fuente y fecha que se sostiene frente a recursos, reclamos de sesgo, y revisión regulatoria." },
