    trainingModules: [
      { icon: "shield", title: "Fundamentos de riesgo de IA y propiedad intelectual", body: "El panorama esencial: dónde residen realmente la propiedad intelectual, los datos, y la responsabilidad en un producto de IA." },
      { icon: "scale", title: "El Reglamento de IA de la UE en la práctica", body: "Clasificación de riesgo, obligaciones, y documentación, traducidas de la regulación a tareas de ingeniería." },
